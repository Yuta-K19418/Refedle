<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Engine\Refedle.Engine.csproj" />
    <ProjectReference Include="..\Generators\Refedle.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.33.0.1635">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.200">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
    <PackageReference Include="Sep" Version="0.17.0" />
  </ItemGroup>

  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)..\..\SonarAnalyzer.globalconfig" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)..\..\MeziantouAnalyzer.globalconfig" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Refedle.Benchmarks" />
    <InternalsVisibleTo Include="Refedle.Tests" />
    <InternalsVisibleTo Include="Refedle.E2ETests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>refedle</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Zero-Warning Policy -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Native AOT Configuration -->
    <PublishAot>true</PublishAot>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <!-- Embed $(Version) into the binary; consumed by the version command and self-update.
       WriteOnlyWhenDifferent keeps the file timestamp stable when unchanged (preserves
       incremental builds); no Inputs/Outputs so -p:Version overrides are always picked up. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <BuildInfoFilePath>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFilePath>
    </PropertyGroup>
    <ItemGroup>
      <!-- %3B / %20 keep semicolons and indentation intact: raw ';' would split items
           and leading whitespace would be trimmed before the file is written. -->
      <BuildInfoLine Include="// &lt;auto-generated/&gt;" />
      <BuildInfoLine Include="namespace Refedle.App%3B" />
      <BuildInfoLine Include="internal static class BuildInfo" />
      <BuildInfoLine Include="{" />
      <BuildInfoLine Include="%20%20%20%20public const string Version = &quot;$(Version)&quot;%3B" />
      <BuildInfoLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(BuildInfoFilePath)" Lines="@(BuildInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFilePath)" AutoGen="true" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
